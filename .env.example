# ============================================================
# REAL JARVIS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your credentials:
#   cp .env.example .env
# ============================================================

# ---------------- IDENTITY ----------------
ASSISTANT_NAME=jarvis
USER_NAME=YourName

# ---------------- SECURITY & AUTHENTICATION ----------------
# Generate password hash with: python config.py set-password
PASSWORD_HASH=
FACE_VERIFICATION_ENABLED=False
AUTH_MODE=either

# ---------------- AI PROVIDERS & API KEYS ----------------
AI_ENABLED=True
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MAX_TOKENS=350
AI_HISTORY_TURNS=4

# ---------------- AUDIO, WAKE & VOICE ----------------
TTS_MODE=auto
ONLINE_VOICE=hi-IN-SwaraNeural
SPEECH_RATE=175
STT_MODE=auto
BARGE_IN_THRESHOLD=0.0018
CLAP_WAKE_ENABLED=False
CLAP_COUNT_REQUIRED=2
CLAP_WINDOW_SECONDS=1.5
PICOVOICE_ACCESS_KEY=

# ---------------- EMAIL (IMAP / SMTP) ----------------
EMAIL_ENABLED=False
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ---------------- WHATSAPP & MOBILE BRIDGE ----------------
WHATSAPP_ENABLED=True
WHATSAPP_AUTO_START=True
MASTER_PHONE=+91XXXXXXXXXX
WHATSAPP_PROVIDER=local
WHATSAPP_AUTO_ALERTS=True

# ---------------- 24/7 DAEMON GATEWAY (SECURITY CRITICAL) ----------------
# Bearer token for the remote REST API. NO default fallback exists -
# the daemon refuses to start without this. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DAEMON_AUTH_TOKEN=
# Bind address. 127.0.0.1 = sirf local machine (safe default).
# Public/phone access ke liye 0.0.0.0 set karo (token zaroori rahega).
DAEMON_HOST=127.0.0.1
DAEMON_PORT=8765

# Twilio credentials. TWILIO_AUTH_TOKEN enable karte hi WhatsApp webhook
# requests X-Twilio-Signature se verify hongi (bina iske webhook band rehta hai).
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ---------------- DOTS STEALTH BROWSER AGENT ----------------
DOTS_ENABLED=True
DOTS_PORT=8766
# Optional: OpenRouter API Key if you want Dots UI to run autonomous multi-turn web tasks
OPENROUTER_API_KEY=
